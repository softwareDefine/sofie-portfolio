# docker compose가 읽는 환경변수 (.env로 복사해서 사용)

# 외부 노출 포트
PORT=8080

# admin 로그인 비밀번호 — 반드시 바꿀 것
ADMIN_PASSWORD=changeme

# admin 로그인 2차 인증 (TOTP, Google Authenticator 호환)
# 생성: node -e "console.log(require('./server/totp').generateSecret())"
# 비워두면 OTP 비활성화 (비밀번호만으로 로그인)
OTP_SECRET=

# 세션 서명 키 (비우면 재시작마다 랜덤 → 재시작 시 로그아웃됨)
SESSION_SECRET=

# DB 위치. 기본값은 compose 내장 postgres(db 서비스).
# 외부 DB 쓰려면 이 값만 바꾸면 됨.
DATABASE_URL=postgres://sofie:sofie@db:5432/sofie_portfolio

# 리버스 프록시(nginx, cloudflared 등) 뒤에서 돌릴 때 1로 설정
# → X-Forwarded-For 기준으로 내부망 판별 (admin 접근 제한용)
TRUST_PROXY=

